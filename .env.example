# Copiá este archivo como .env.local y completá lo que haga falta.

# URL pública del sitio, sin barra final. Es la que va en los QR de los certificados:
# definila ANTES de emitir certificados reales, porque el papel impreso no se actualiza.
APP_URL=http://localhost:3000

# Base de datos. Vacío = PGlite local en .data/pglite (no hace falta instalar nada).
# En el piloto: la cadena del pooler de Supabase (modo transacción, puerto 6543).
DATABASE_URL=

# Secreto para firmar códigos y sesiones. Obligatorio en producción. Generalo con:
#   openssl rand -base64 48
AUTH_SECRET=

# Mails de las personas de Impulso que administran el piloto, separados por coma.
ADMIN_EMAILS=

# 'bandeja' = los mails no salen y se ven en /demo/bandeja (demo y desarrollo).
# 'resend'  = salen de verdad por Resend.
MAIL_MODE=bandeja
RESEND_API_KEY=
MAIL_FROM="Avalya <hola@tu-dominio.com>"

# Ambiente de demostración: bandeja en pantalla, accesos rápidos y botón para reiniciar.
# NUNCA en el ambiente del piloto.
DEMO_MODE=false
